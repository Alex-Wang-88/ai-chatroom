{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Chat Room",
  "version": "0.1.0",
  "identifier": "com.aichatroom.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../../frontend -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build --prefix ../../frontend",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Chat Room",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": []
  }
}
