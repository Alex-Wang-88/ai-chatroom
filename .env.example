APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./data/ai_chat_room.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JIMO_BASE_URL=https://jimoai-bot-api.xiaohuodui.cn
JIMO_AUTHORIZATION=
JIMO_AUTH_SCHEME=bearer
JIMO_CHAT_ENDPOINT=/v1/chat/completions
JIMO_TIMEOUT_SECONDS=240
JIMO_CONNECT_TIMEOUT_SECONDS=15
JIMO_IDLE_TIMEOUT_SECONDS=45
JIMO_STREAMING=true
JIMO_MODEL_DEEPSEEKV4LASH=
# Optional spelling-compatible alias for deployments using "deepseekv4flash".
JIMO_MODEL_DEEPSEEKV4FLASH=
JIMO_MODEL_QWEN36FLASH=
JIMO_MODEL_GLM53FLASH=
# Optional per-agent /v2/chat/completions/share URLs. Keep share IDs private.
JIMO_SHARE_URL_DEEPSEEKV4LASH=
JIMO_SHARE_URL_DEEPSEEKV4FLASH=
JIMO_SHARE_URL_QWEN36FLASH=
JIMO_SHARE_URL_GLM53FLASH=
CONTEXT_MESSAGE_LIMIT=20
CONTEXT_CHARACTER_BUDGET=24000
FREE_MAX_MESSAGES=8
FREE_MAX_CONSECUTIVE_MESSAGES=2
FREE_ERROR_THRESHOLD=3
WS_RING_BUFFER_SIZE=1000
LOG_LEVEL=INFO
